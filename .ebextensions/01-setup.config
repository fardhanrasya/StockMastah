packages:
  yum:
    amazon-efs-utils: []

commands:
  01_mount_efs_exports:
    command: |
      mkdir -p /exports
      mount -t efs -o tls,accesspoint=fsap-XXXXXXXX /exports || echo "Failed to mount EFS to /exports"
    ignoreErrors: true
  02_mount_efs_uploads:
    command: |
      mkdir -p /uploads
      mount -t efs -o tls,accesspoint=fsap-YYYYYYYY /uploads || echo "Failed to mount EFS to /uploads"
    ignoreErrors: true
